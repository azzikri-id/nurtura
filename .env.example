# Salin file ini menjadi .env.local lalu isi nilainya. .env.local TIDAK boleh di-commit.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (jangan diawali NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# AI (Google AI Studio → Get API key)
GEMINI_API_KEY=

# Kunci enkripsi kolom NIK: 32 byte acak dalam base64
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NIK_ENCRYPTION_KEY=
